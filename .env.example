# ---------------------------------------------------------------- application
APP_NAME="MOVICO Recommendation Service"
APP_ENV=development
# Leave DEBUG off in production: it echoes exception messages to the client.
DEBUG=true
PORT=8005

# Sign JWTs with a real random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-this-with-a-very-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required header value (X-Admin-Token) for the maintenance endpoints that
# retrain models and rewrite the catalogue. Leave blank to disable them entirely,
# which is the right setting for a public deployment you are not administering.
ADMIN_TOKEN=

# Browser origins allowed to call the API, comma separated. Localhost dev ports
# are always allowed; add the deployed frontend here.
#   CORS_ORIGINS=https://movico.vercel.app
CORS_ORIGINS=

# ------------------------------------------------------------------- database
# SQLite is the default and is sufficient for this workload: the catalogue is
# read-mostly and the model artifacts live on disk, not in the database.
USE_SQLITE=true
POSTGRES_USER=movico_user
POSTGRES_PASSWORD=movico_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movico_db

# ---------------------------------------------------------------------- cache
# The in-process TTL cache is the default tier and needs no external service.
# Only enable Redis if you are running more than one API instance and want them
# to share a cache.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_EXPIRE_SECONDS=600

# ----------------------------------------------------------------------- TMDB
# Free key, no card required: https://www.themoviedb.org/settings/api
# Drives every poster, backdrop, trailer, cast list and plot in the catalogue.
TMDB_API_KEY=your-tmdb-api-key-here

# -------------------------------------------------------------- data & models
DATA_DIR="./data"
MODELS_DIR="./models_checkpoint"

# ml-latest is the full archive (~33M ratings, 86k titles, 335MB download).
# Swap to ml-latest-small for a fast development loop.
MOVIELENS_DATASET_URL="https://files.grouplens.org/datasets/movielens/ml-latest.zip"

# ------------------------------------------------------------------ inference
RECOMMENDATION_LIMIT=20
COLD_START_THRESHOLD=5

# ------------------------------------------------------------------- training
# Overridable on the command line: python -m app.ml.train --factors 256
SVD_FACTORS=128
SVD_EPOCHS=14
TRAINING_SAMPLE_SIZE=0
