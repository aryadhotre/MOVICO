# ---------------------------------------------------------------- application
APP_NAME="MOVICO Recommendation Service"
# Set to "production" on a deployed instance. Doing so turns the settings below
# into hard requirements: the app refuses to start with a placeholder SECRET_KEY,
# with DEBUG on, or with CORS_ORIGINS empty. See app/config/settings.py.
APP_ENV=development
# Off by default. It echoes exception messages -- file paths, library versions --
# to the client, and is refused outright when APP_ENV=production.
DEBUG=true
PORT=8005

# Sign JWTs with a real random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-this-with-a-very-secure-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Required header value (X-Admin-Token) for the maintenance endpoints that
# retrain models and rewrite the catalogue. Leave blank to disable them entirely,
# which is the right setting for a public deployment you are not administering.
ADMIN_TOKEN=

# Browser origins allowed to call the API, comma separated. Localhost dev ports
# are allowed automatically in development and NOT in production, so a deployed
# instance must name its frontend here or every request is blocked.
#   CORS_ORIGINS=https://movico.vercel.app
CORS_ORIGINS=

# Vercel project slug, e.g. "movico". Preview deployments get a generated
# subdomain per commit, so they cannot be listed above; this allows the ones
# derived from your project slug and nothing else. Leaving it blank allows no
# previews. Never widen this to a bare *.vercel.app pattern -- anyone can deploy
# to vercel.app, and with credentials allowed that would let their page read
# authenticated responses on a logged-in visitor's behalf.
VERCEL_PROJECT=

# ------------------------------------------------------------------- database
# Two databases, split by how the data behaves.
#
# The CATALOGUE -- 96k films, artwork, credits, ranking scores -- is always local
# SQLite at DATA_DIR/movico.db. It is read on nearly every request and rebuilt
# offline, so it ships inside the image as a build artifact.
#
# The USER database -- accounts, password hashes, ratings, watchlists -- is small,
# mutable and irreplaceable. Set DATABASE_URL to a managed Postgres (Supabase) in
# production; free-tier containers have no persistent disk, so anything written
# locally is lost on every deploy. Leave it blank and both halves share the local
# SQLite file, which is what a fresh checkout wants.
#
# Use the Supabase **transaction pooler** URI (port 6543), not the direct
# connection: a free project allows only 60 direct sessions.
#   DATABASE_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# How much of the catalogue to memory-map, in MB. Mapped pages are reclaimable
# and cannot cause an OOM, but they count toward a container's memory limit --
# drop this to 64 on a 512 MB instance, where the model artifacts already hold
# ~250 MB.
SQLITE_MMAP_MB=256

# Legacy single-database settings, used only when DATABASE_URL is unset.
USE_SQLITE=true
POSTGRES_USER=movico_user
POSTGRES_PASSWORD=movico_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=movico_db

# ---------------------------------------------------------------------- cache
# The in-process TTL cache is the default tier and needs no external service.
# Only enable Redis if you are running more than one API instance and want them
# to share a cache.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CACHE_EXPIRE_SECONDS=600

# ----------------------------------------------------------------------- TMDB
# Free key, no card required: https://www.themoviedb.org/settings/api
# Drives every poster, backdrop, trailer, cast list and plot in the catalogue.
TMDB_API_KEY=your-tmdb-api-key-here

# -------------------------------------------------------------- data & models
DATA_DIR="./data"
MODELS_DIR="./models_checkpoint"

# ml-latest is the full archive (~33M ratings, 86k titles, 335MB download).
# Swap to ml-latest-small for a fast development loop.
MOVIELENS_DATASET_URL="https://files.grouplens.org/datasets/movielens/ml-latest.zip"

# ------------------------------------------------------------------ inference
RECOMMENDATION_LIMIT=20
COLD_START_THRESHOLD=5

# ------------------------------------------------------------------- training
# Overridable on the command line: python -m app.ml.train --factors 256
SVD_FACTORS=128
SVD_EPOCHS=14
TRAINING_SAMPLE_SIZE=0

# ------------------------------------------------------------------ deployment
# The catalogue and trained models are too large for the repository (~215 MB and
# ~127 MB), so a deployed build downloads them from a GitHub release asset. Build
# the bundle with `python -m scripts.package_artifacts`, upload it to a release,
# then set these. The checksum is not optional in spirit: without it a truncated
# download produces an image that starts cleanly and serves a corrupt catalogue.
ARTIFACTS_URL=
ARTIFACTS_SHA256=
