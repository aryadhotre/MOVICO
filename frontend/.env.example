# Base URL of the MOVICO API.
#
# Leave this blank for local development: the Vite dev server proxies /api to the
# backend, so the browser talks to one origin and never issues a CORS preflight.
#
# Set it when the frontend and API are deployed separately (Vercel + Render), e.g.
#   VITE_API_URL=https://movico-api.onrender.com
#
# If you do point this at a local backend, use 127.0.0.1 rather than localhost.
# On Windows, "localhost" resolves to the IPv6 ::1 first while uvicorn binds IPv4
# only, so every request pays ~200ms for a failed connection before falling back.
VITE_API_URL=

# Backend the dev-server proxy forwards /api to. Only needed if the API is not on
# the default port.
# VITE_PROXY_TARGET=http://127.0.0.1:8005
